<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="159.0" prefWidth="319.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox alignment="CENTER" prefHeight="236.0" prefWidth="319.0">
         <children>
            <VBox alignment="CENTER" prefHeight="236.0" prefWidth="237.0" style="-fx-padding: 10px; -fx-spacing: 10px;">
               <children>
                  <Label prefHeight="17.0" prefWidth="230.0" text="Entrez un nom pour sauvegarder la piste" />
                  <TextField fx:id="nomPiste" prefHeight="26.0" prefWidth="127.0" />
                  <Button fx:id="saveButton" mnemonicParsing="false" style="-fx-border-color: gray; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-background-insets: 0; -fx-background-color: #2e3436; -fx-text-fill: white;" text="Sauvegarder" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
