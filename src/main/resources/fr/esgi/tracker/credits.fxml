<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600" prefWidth="900" style="-fx-background-color: #1e1e2f;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.esgi.tracker.controller.CreditsController">
   <AnchorPane prefHeight="200.0" prefWidth="200.0">
      <children>

           <VBox fx:id="creditsBox" alignment="CENTER" layoutX="298.0" layoutY="102.0" spacing="15" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="150.0" AnchorPane.topAnchor="100.0">
               <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="Crédits de l'application" />
               <Label style="-fx-text-fill: #cccccc; -fx-font-size: 22px;" text=" FXML Tracker App " />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                     <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="Créer et Designer par :">
                     <HBox.margin>
                        <Insets right="30.0" />
                     </HBox.margin>
                  </Label>
                  <VBox alignment="CENTER_LEFT">
                     <children>
                        <Label alignment="CENTER" style="-fx-text-fill: white; -fx-font-size: 16px;" text="Loise Meline, Nicolas Carpita," />
                        <Label alignment="CENTER" style="-fx-text-fill: white; -fx-font-size: 18px;" text="Jose Vasquez , Albin Riviere.">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text=" Année 2025-2026 ">
               <font>
                  <Font size="10.0" />
               </font></Label>

              <Label fx:id="thankYouLabel" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold;" text="Merci ! 🙂" textFill="#f3dbdb" />
           </VBox>
      

           <Button fx:id="backButton" alignment="TOP_LEFT" layoutY="14.0" onAction="#switchToPrimary" style="-fx-background-color: #5a5aff; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 14px; -fx-padding: 6 20;" text="← Retour" AnchorPane.leftAnchor="15.0" AnchorPane.topAnchor="15.0" />
      </children>
   </AnchorPane>

</StackPane>
